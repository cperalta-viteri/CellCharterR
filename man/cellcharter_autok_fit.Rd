toy_fit <- function(x, n_clusters, seed, device) {
  fit <- withr::with_seed(
    seed, stats::kmeans(x, centers = n_clusters, nstart = 1)
  )
  list(labels = fit$cluster, nll = fit$tot.withinss, device = device)
}
