```{r setup, include=FALSE}
# All analysis code remains visible in the rendered report.
knitr::opts_chunk$set(echo = TRUE, message = TRUE, warning = TRUE,
                      fig.align = "center", fig.retina = 1,
                      dev.args = list(pointsize = 16))
project_root <- if (file.exists(file.path(getwd(), "DESCRIPTION"))) {
  getwd()
} else if (file.exists(file.path(dirname(getwd()), "DESCRIPTION"))) {
  dirname(getwd())
} else {
  stop("Render from the CellCharterR repository root or its reports directory.")
}
requested_result_dir <- params$result_dir
if (!grepl("^/", requested_result_dir)) {
  requested_result_dir <- file.path(project_root, requested_result_dir)
}
result_dir <- normalizePath(requested_result_dir, winslash = "/", mustWork = TRUE)
manifest <- readRDS(file.path(result_dir, "CellCharterR_primary_K11_manifest.rds"))
stopifnot(
  identical(manifest$tool, "CellCharterR"),
  identical(manifest$roles$Primary$role_id, "r_autok_primary"),
  identical(manifest$roles$TutorialK11$role_id, "r_tutorial_k11_sensitivity"),
  identical(manifest$roles$TutorialK11$seed, 12345L),
  identical(
    manifest$roles$PublishedH5ADReference$role_id,
    "published_h5ad_reference"
  ),
  identical(manifest$displayed_samples, c("BALBc-1", "MRL-4")),
  file.exists(manifest$autok_stability_plot),
  identical(manifest$enrichment_plot_parameters$group_key, "cell_type"),
  identical(manifest$enrichment_plot_parameters$size_threshold, 0.58),
  identical(manifest$enrichment_plot_parameters$color_threshold, 0.58),
  isTRUE(manifest$enrichment_plot_parameters$cluster_labels),
  identical(manifest$differential_parameters$significance, 0.05)
)

map_to_spe <- function(data, k) {
  samples <- c("BALBc-1", "MRL-4")
  keep <- as.character(data$sample) %in% samples
  data <- data[keep, , drop = FALSE]
  display_spe <- SpatialExperiment::SpatialExperiment(
    assays = list(display = matrix(0, nrow = 1L, ncol = nrow(data))),
    colData = S4Vectors::DataFrame(
      sample_id = factor(
        as.character(data$sample), levels = samples,
        labels = c("BALBc-1", "MRL-4 (early)")
      ),
      domain = factor(data$domain, levels = seq.int(0L, k - 1L))
    ),
    spatialCoords = as.matrix(data[, c("x", "y")]),
    sample_id = factor(
      as.character(data$sample), levels = samples,
      labels = c("BALBc-1", "MRL-4 (early)")
    )
  )
  display_spe
}

matrix_long <- function(x, value_name, condition = NULL) {
  result <- as.data.frame(as.table(as.matrix(x)), stringsAsFactors = FALSE)
  names(result) <- c("source", "target", value_name)
  if (!is.null(condition)) result$condition <- condition
  result
}

plot_enrichment_dotplot <- function(enrichment, k) {
  values <- as.matrix(enrichment$enrichment)
  size_threshold <- 0.58
  color_threshold <- 0.58

  # CellCharter v0.2.0 defaults to cluster_labels=TRUE. Its complete-linkage
  # clustering uses the thresholded color matrix, not the raw enrichment.
  color_values <- ifelse(
    values < 0, -1,
    ifelse(values < color_threshold, 0, 1)
  )
  domain_order <- colnames(values)
  if (ncol(values) > 1L) {
    domain_order <- domain_order[stats::hclust(
      stats::dist(t(color_values)), method = "complete"
    )$order]
  }

  cells <- expand.grid(
    cell_type = rownames(values), domain = colnames(values),
    KEEP.OUT.ATTRS = FALSE, stringsAsFactors = FALSE
  )
  cells$value <- as.vector(values)
  # CellCharter maps [-1, 0.58] through TwoSlopeNorm. Scanpy 1.9.3 then
  # clips negative dot-size fractions to zero and uses area = fraction^1.5.
  # Base R `cex` scales diameter, hence exponent 1.5 / 2 = 0.75 here.
  cells$size <- pmax(0, pmin(cells$value, size_threshold)) / size_threshold
  cells$color_value <- as.vector(color_values)
  palette <- grDevices::colorRampPalette(
    c("#3B4CC0", "darkgrey", "#B40426")
  )(101)
  color_index <- pmax(
    1L, pmin(101L, round((cells$color_value + 1) * 50) + 1L)
  )
  graphics::plot(
    as.integer(factor(cells$cell_type, levels = rownames(values))),
    as.integer(factor(cells$domain, levels = domain_order)),
    pch = 21, bg = palette[color_index], col = "black",
    cex = 2.5 * cells$size^0.75, axes = FALSE,
    xlim = c(0.5, nrow(values) + 9),
    xlab = "", ylab = "Spatial domain (complete-linkage order)",
    main = paste0("Cluster ~ full cell type enrichment (K=", k, ")")
  )
  graphics::axis(
    1, at = seq_len(nrow(values)), labels = rownames(values),
    las = 2, cex.axis = 1
  )
  graphics::axis(
    2, at = seq_along(domain_order), labels = domain_order, las = 1
  )
  graphics::box()
  graphics::mtext("Cell type", side = 1, line = 16)
  graphics::legend(
    x = nrow(values) + 1, y = max(seq_along(domain_order)), xjust = 0,
    legend = c("depleted", "positive < 0.58", "enriched >= 0.58"),
    pt.bg = c("#3B4CC0", "darkgrey", "#B40426"),
    pch = 21, cex = 1, title = "log2 observed/expected", bty = "n"
  )
}

plot_heatmap <- function(x, title, limits = NULL, annotate = FALSE,
                         pvalue = NULL, significance = NULL) {
  x <- as.matrix(x)
  plotted <- x
  plotted[!is.finite(plotted)] <- NA_real_
  if (is.null(limits)) {
    limits <- range(plotted, finite = TRUE)
  }
  if (length(limits) != 2L || any(!is.finite(limits)) || limits[[1L]] >= 0 ||
      limits[[2L]] <= 0) {
    stop("Heatmap limits must be finite and span zero, as required by TwoSlopeNorm.")
  }
  palette <- grDevices::hcl.colors(101, "Blue-Red 3", rev = TRUE)
  graphics::image(
    seq_len(ncol(plotted)), seq_len(nrow(plotted)), t(plotted),
    col = palette, zlim = limits, axes = FALSE,
    xlab = "target domain", ylab = "source domain", main = title,
    useRaster = TRUE
  )
  graphics::axis(
    1, at = seq_len(ncol(plotted)), labels = colnames(plotted), las = 2
  )
  graphics::axis(
    2, at = seq_len(nrow(plotted)), labels = rownames(plotted), las = 2
  )
  graphics::box()
  if (annotate) {
    for (i in seq_len(nrow(plotted))) for (j in seq_len(ncol(plotted))) {
      if (!is.finite(plotted[i, j])) next
      significant <- !is.null(pvalue) && !is.null(significance) &&
        is.finite(pvalue[i, j]) && pvalue[i, j] <= significance
      label <- paste0(sprintf("%.2f", plotted[i, j]), if (significant) "*" else "")
      graphics::text(j, i, label, cex = 1)
    }
  }
}
```

# Scope and artifact roles

This report consumes regenerated outputs under a new result root. The frozen
Phase-0 report and artifacts are provisional/stale and are not used here. The
primary result is whatever K the R AutoK run selected independently; it is never
fixed to K=4 or K=11. The K=11 panel is a separate `torch_gmm_fit()` sensitivity
fit corresponding to `Cluster(n_clusters=11, random_state=12345)`. Its integer
seed is matched, but R and Python use different initialization and random-number
streams, so this does not claim seed-identical fitted parameters. Published H5AD
`cluster_cellcharter` labels are retained only as a third reference artifact and
are not plotted as the R tutorial fit.

```{r roles, echo=TRUE, eval=FALSE}
role_table <- do.call(rbind, lapply(manifest$roles, function(x) data.frame(
  role_id = x$role_id,
  k = x$k,
  seed = if (is.na(x$seed)) "NA (not an R fit)" else as.character(x$seed),
  model_path = if (is.na(x$model_path)) "NA (published labels)" else x$model_path,
  cell_order_sha256 = x$cell_order_sha256,
  aggregation_data_id = x$aggregation_data_id,
  stringsAsFactors = FALSE
)))
knitr::kable(role_table, caption = "Non-interchangeable analysis roles")
```

Only BALBc-1 and early MRL-4 are displayed in maps. Enrichment and proximity
statistics use all nine libraries. The full `cell_type` annotation is used for
the log2 observed/expected dot plot with `size_threshold=0.58`,
`color_threshold=0.58`, and the CellCharter v0.2.0 default clustered labels.

# From input SPE to saved results

The full mouse-spleen analysis is deliberately not rerun while this report is
rendered. The code below shows the public stages used to create the graph,
in-memory neighborhood representation, AutoK fit, selected domains, and
downstream statistics. The evaluated sections that follow load the corresponding
precomputed artifacts and display their outputs.

```{r full-staged-workflow, eval=FALSE}
full_spe <- readRDS("results/CellCharterR_mouse_spleen_v2/representation/codex_sce.rds")

full_spe <- cellcharter_graph(
  full_spe,
  spatial = "spatial",
  sample_col = "sample",
  graph_name = "cellcharter_graph",
  percentile = 99
)

full_spe <- cellcharter_aggregate(
  full_spe,
  representation = "X_trVAE",
  graph_name = "cellcharter_graph",
  sample_col = "sample",
  output = "X_cellcharter",
  n_layers = 3L
)

saveRDS(
  full_spe,
  "results/CellCharterR_mouse_spleen_v2/aggregation/spe_after_aggregation.rds",
  compress = FALSE
)

full_spe <- cellcharter_cluster(
  full_spe,
  representation = "X_cellcharter",
  candidate_k = 2:20,
  checkpoint_dir = "results/CellCharterR_mouse_spleen_v2/autok",
  domain_col = "cellcharter_domain",
  max_runs = 10L,
  convergence_tol = 0.01,
  seed = 1L,
  fit_args = list(device = "auto", batch_size = 8192L),
  predict_args = list(device = "auto", batch_size = 8192L),
  resume = TRUE
)

full_spe <- cellcharter_enrichment(
  full_spe,
  group_col = "cell_type",
  domain_col = "cellcharter_domain"
)
full_spe <- cellcharter_nhood_enrichment(
  full_spe,
  graph_name = "cellcharter_graph",
  domain_col = "cellcharter_domain"
)
full_spe <- cellcharter_diff_nhood_enrichment(
  full_spe,
  graph_name = "cellcharter_graph",
  domain_col = "cellcharter_domain",
  condition_col = "condition",
  sample_col = "sample",
  condition_groups = c("BALBc", "MRL"),
  n_perms = 100L,
  seed = 1L
)

saveRDS(
  full_spe,
  "results/CellCharterR_mouse_spleen_v2/downstream/codex_spe_complete.rds"
)
```

## Resume AutoK after an interruption

Keep the post-aggregation SPE and AutoK directory together. Days or weeks
later, repeat the exact clustering call with
`resume = TRUE`; completed `run_*.rds` fits are reused.

```{r full-resume-workflow, eval=FALSE}
full_spe <- readRDS(
  "results/CellCharterR_mouse_spleen_v2/aggregation/spe_after_aggregation.rds"
)

full_spe <- cellcharter_cluster(
  full_spe,
  representation = "X_cellcharter",
  candidate_k = 2:20,
  checkpoint_dir = "results/CellCharterR_mouse_spleen_v2/autok",
  domain_col = "cellcharter_domain",
  max_runs = 10L,
  convergence_tol = 0.01,
  seed = 1L,
  fit_args = list(device = "cuda", batch_size = 16384L),
  predict_args = list(device = "cuda", batch_size = 32768L),
  resume = TRUE
)
```

## Optional compact wrapper

For a compact dataset, `cellcharter_workflow()` composes the same stages. It is
shown for completeness, but the staged version above is preferable for the full
dataset because it exposes each durable checkpoint. If aggregation exceeds
available RAM, add `filepath = ...` and retain that optional HDF5 file with the SPE.

```{r full-workflow-wrapper, eval=FALSE}
full_spe <- cellcharter_workflow(
  full_spe,
  group_col = "cell_type",
  candidate_k = 2:20,
  checkpoint_dir = "results/CellCharterR_mouse_spleen_v2/autok",
  representation = "X_trVAE",
  sample_col = "sample",
  condition_col = "condition",
  aggregated = "X_cellcharter",
  domain_col = "cellcharter_domain",
  n_layers = 3L,
  condition_groups = c("BALBc", "MRL"),
  n_perms = 100L,
  seed = 1L
)
```


# AutoK stability and K selection

The points are all saved neighboring-K Fowlkes--Mallows comparisons from the
seven repeated fits; the line is their mean. K=1 is shown as non-estimable
because this criterion requires fitted solutions on both neighboring K values.
K=4 is the independently selected global maximum. K=11 is annotated only as
the predeclared tutorial-matched sensitivity and lies on the secondary K=10--11
stability shoulder.

```{r autok-stability, echo=TRUE, out.width="100%", fig.alt="Mouse-spleen neighboring-K Fowlkes-Mallows stability from K=1 through K=20; K=4 is selected and K=11 is highlighted"}
knitr::include_graphics(manifest$autok_stability_plot)
```

# Independently R-selected AutoK primary analysis

```{r primary-load, echo=TRUE}
primary_k <- manifest$primary_k
primary_paths <- manifest$artifacts$Primary
primary_map <- readRDS(primary_paths[["map_input"]])
primary_enrichment <- readRDS(primary_paths[["enrichment"]])
primary_nhood <- readRDS(primary_paths[["nhood"]])
primary_mrl_balbc <- readRDS(primary_paths[["differential_mrl_balbc"]])
primary_balbc_mrl <- readRDS(primary_paths[["differential_balbc_mrl"]])
```

## BALBc-1 and early MRL-4 domains

```{r primary-maps, echo=TRUE, fig.width=12, fig.height=5.5, fig.alt="Primary K=4 spatial domains on BALBc-1 and early MRL-4"}
primary_spe <- map_to_spe(primary_map, primary_k)
ggspavis::plotCoords(
  primary_spe,
  annotate = "domain",
  sample_id = "sample_id",
  in_tissue = NULL,
  point_size = 0.1,
  pal = grDevices::hcl.colors(primary_k, "Dynamic")
) +
  ggplot2::labs(
    colour = "Domain",
    title = paste0("Primary R-selected spatial domains: K = ", primary_k)
  ) +
  ggplot2::theme_minimal(base_size = 16)
```

```{r primary-map-table, echo=TRUE, eval=FALSE}
knitr::kable(
  as.data.frame(table(sample = primary_map$sample, domain = primary_map$domain)),
  caption = "Accessible cell counts underlying the primary domain maps"
)
```

## Cluster ~ full cell type dot plot (log2 observed/expected)

```{r primary-dotplot, echo=TRUE, fig.width=18, fig.height=9, fig.alt="Positive cell-type enrichment by primary K=4 domain; darker and larger red points indicate stronger positive log2 fold change"}
graphics::par(mar = c(18, 6, 3, 1))
CellCharterR::cellcharter_plot_enrichment(
  primary_enrichment,
  title = paste0("Cluster ~ full cell type enrichment (K=", primary_k, ")")
)
```

```{r primary-dotplot-table, echo=TRUE, eval=FALSE}
primary_enrichment_table <- as.data.frame(
  as.table(primary_enrichment$enrichment), stringsAsFactors = FALSE
)
names(primary_enrichment_table) <- c("cell_type", "domain", "log2_enrichment")
knitr::kable(primary_enrichment_table,
             caption = "Values underlying the primary enrichment dot plot")
```

## BALBc and MRL neighborhood enrichment

```{r primary-nhood, echo=TRUE, fig.width=12, fig.height=5.5, fig.alt="Directed observed-minus-expected neighborhood enrichment for BALBc and MRL at primary K=4"}
graphics::par(mfrow = c(1, 2), mar = c(5, 5, 3, 1))
plot_heatmap(
  primary_nhood$BALBc$enrichment, "Healthy spleen — BALBc",
  limits = c(-1, 1), annotate = TRUE
)
plot_heatmap(
  primary_nhood$MRL$enrichment, "Systemic lupus — MRL",
  limits = c(-1, 1), annotate = TRUE
)
```

```{r primary-nhood-table, echo=TRUE, eval=FALSE}
primary_nhood_table <- rbind(
  matrix_long(primary_nhood$BALBc$enrichment, "enrichment", "BALBc"),
  matrix_long(primary_nhood$MRL$enrichment, "enrichment", "MRL")
)
knitr::kable(primary_nhood_table,
             caption = "Values underlying the primary neighborhood heatmaps")
```

## Differential neighborhood enrichment in both display directions

Both panels reuse one sample-level permutation result (`n_perms=100`). A star
marks directional empirical `p <= 0.05`; reversing the display negates only the
effect and reuses the same permutation counts and p-values.

```{r primary-differential, echo=TRUE, fig.width=12, fig.height=5.5, fig.alt="Differential directed neighborhood enrichment shown as MRL minus BALBc and the reversed BALBc minus MRL display"}
graphics::par(mfrow = c(1, 2), mar = c(5, 5, 3, 1))
plot_heatmap(
  primary_mrl_balbc$effect, "MRL vs BALBc", annotate = TRUE,
  pvalue = primary_mrl_balbc$pvalue, significance = 0.05
)
plot_heatmap(
  primary_balbc_mrl$effect, "BALBc vs MRL", annotate = TRUE,
  pvalue = primary_balbc_mrl$pvalue, significance = 0.05
)
```

```{r primary-differential-table, echo=TRUE, eval=FALSE}
primary_diff_table <- matrix_long(primary_mrl_balbc$effect, "MRL_minus_BALBc")
primary_diff_table$empirical_pvalue <- as.vector(primary_mrl_balbc$pvalue)
knitr::kable(primary_diff_table,
             caption = "Values underlying the primary differential heatmaps")
```

# Standalone tutorial-matched K=11 sensitivity analysis

```{r k11-load, echo=TRUE}
k11_paths <- manifest$artifacts$TutorialK11
k11_map <- readRDS(k11_paths[["map_input"]])
k11_enrichment <- readRDS(k11_paths[["enrichment"]])
k11_nhood <- readRDS(k11_paths[["nhood"]])
k11_mrl_balbc <- readRDS(k11_paths[["differential_mrl_balbc"]])
k11_balbc_mrl <- readRDS(k11_paths[["differential_balbc_mrl"]])
```

